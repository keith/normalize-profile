#!/usr/bin/env python3

import argparse
import datetime
import hashlib
import os
import plistlib
import subprocess
import sys

_NOISY_FIELDS = [
    "CreationDate",
    "DER-Encoded-Profile",
    "ExpirationDate",
    "TimeToLive",
    "UUID",
]


def _describe_cert(cert):
    output = subprocess.run(
        [
            "openssl",
            "x509",
            "-inform",
            "der",
            "-noout",
            "-subject",
            "-enddate",
            "-nameopt",
            "multiline,utf8,-esc_msb",
        ],
        input=cert,
        stdout=subprocess.PIPE,
        stderr=subprocess.DEVNULL,
        check=True,
    ).stdout.decode()

    common_name = "unknown"
    expiration = "unknown"
    for line in output.splitlines():
        key, _, value = line.strip().partition("=")
        if key.strip() == "commonName":
            common_name = value.strip()
        elif key == "notAfter":
            date = datetime.datetime.strptime(value, "%b %d %H:%M:%S %Y %Z")
            expiration = date.strftime("%Y-%m-%dT%H:%M:%SZ")

    sha = hashlib.sha256(cert).hexdigest()
    return f"{common_name}, expires {expiration}, sha256 {sha}"


parser = argparse.ArgumentParser()
parser.add_argument("profile", help="The provisioning file to process")
parser.add_argument(
    "--ignore-invalid",
    action="store_true",
    help="Ignore invalid profiles and print a constant string",
)
parser.add_argument(
    "--ignore-field",
    action="append",
    help="Fields to strip from the profile for diffing, useful to ignore things that always change like UUID",
    default=[],
)
parser.add_argument(
    "--ignore-noisy-fields",
    action="store_true",
    help="Ignore fields in the profile that always change such as UUID or creation and expiration dates",
    default=False,
)
parser.add_argument(
    "--shorten-certs",
    action="store_true",
    help="Shorten the developer certificate data for easier diffing, these values won't have any relation to the certificate, but will be reproducible",
    default=False,
)
parser.add_argument(
    "--describe-certs",
    action="store_true",
    help="Replace the developer certificate data with each certificate's common name, expiration date, and SHA-256 for easier reviewing, takes precedence over --shorten-certs for developer certificates, combine with --shorten-certs to also shorten DER-Encoded-Profile",
    default=False,
)
args = parser.parse_args()
fields_to_ignore = args.ignore_field
if args.ignore_noisy_fields:
    fields_to_ignore.extend(_NOISY_FIELDS)

if not os.path.isfile(args.profile):
    raise SystemExit(f"error: {args.profile} does not exist")

try:
    process = subprocess.run(
        [
            "openssl",
            "smime",
            "-inform",
            "der",
            "-verify",
            "-noverify",
            "-in",
            args.profile,
        ],
        stdout=subprocess.PIPE,
        stderr=subprocess.DEVNULL,
        check=True,
    )

    plist = plistlib.loads(process.stdout)
    for field in fields_to_ignore:
        if field in plist:
            del plist[field]

    if args.describe_certs and "DeveloperCertificates" in plist:
        cert_descriptions = []
        certs = plist.pop("DeveloperCertificates")
        for cert in certs:
            cert_descriptions.append(_describe_cert(cert))
        plist["DeveloperCertificates"] = sorted(cert_descriptions)
    elif args.shorten_certs and "DeveloperCertificates" in plist:
        cert_shas = []
        certs = plist.pop("DeveloperCertificates")
        for cert in certs:
            cert_shas.append(hashlib.sha256(cert).hexdigest())
        plist["DeveloperCertificates"] = sorted(cert_shas)
    if args.shorten_certs and "DER-Encoded-Profile" in plist:
        cert = plist.pop("DER-Encoded-Profile")
        cert = hashlib.sha256(cert).hexdigest()
        plist["DER-Encoded-Profile"] = cert
    if "ProvisionedDevices" in plist:
        plist["ProvisionedDevices"] = sorted(plist["ProvisionedDevices"])

    plistlib.dump(plist, sys.stdout.buffer, sort_keys=True)
except subprocess.CalledProcessError:
    if args.ignore_invalid:
        print("warning: failed to read profile")
    else:
        sys.exit(f"error: failed to parse '{args.profile}'")
